<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<!-- Definir los objetivos donde se almacenarán los logs -->
	<targets>
		<!-- Log en la consola -->
		<target xsi:type="Console" name="console" layout="${longdate} ${uppercase:${level}} ${message} ${exception}" />

		<!-- Log en un archivo -->
		<target xsi:type="File" name="file" fileName="logs/logfile.log"
				layout="${longdate} ${uppercase:${level}} ${message} ${exception}" />
	</targets>

	<!-- Reglas para enrutar los logs -->
	<rules>
		<!-- Enviar todos los mensajes de log a la consola -->
		<logger name="*" minlevel="Info" writeTo="console" />

		<!-- Enviar todos los mensajes de log a un archivo -->
		<logger name="*" minlevel="Info" writeTo="file" />
	</rules>
</nlog>